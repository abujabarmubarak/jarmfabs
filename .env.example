# JarmFabs Technologies Environment Configuration

# Flask Secret Key
SECRET_KEY=jarmfabs-technologies-secret-key-2026-super-secure

# PostgreSQL Database Connection String
# Replace username, password, host, port, and dbname with your PostgreSQL credentials:
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/jarmfabs_db

# If DATABASE_URL is omitted or unset, the application automatically falls back to:
# sqlite:///jarmfabs.db
